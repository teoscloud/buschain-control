#!/usr/bin/env bash
# GTK mixer launcher — nix develop + packaged installs.
#
# Develop: shellHook sets BUSCHAIN_CONTROL_PYTHON to the pygobject interpreter;
#          this script runs packaging/mixer/legacy/*.py (live edits).
# Packaged: `buschain-mixer-gtk` on PATH is the wrapGApps binary from
#           packaging/nix/gtk-mixer.nix (gi + layer-shell). Prefer that when
#           this checkout script cannot find a working Python.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
PY="$ROOT/legacy/buschain-mixer.py"
CSS="$ROOT/legacy/style.css"
FLAKE_ROOT="$(cd "$ROOT/../.." && pwd)"

if [[ ! -f "$PY" ]]; then
  echo "buschain-mixer-gtk: missing $PY" >&2
  exit 1
fi

export BUSCHAIN_CONTROL_MIXER_CSS="${BUSCHAIN_CONTROL_MIXER_CSS:-$CSS}"
# WhiteSur-dark (and some icon themes) abort GTK when `image-missing` is absent.
export GTK_ICON_THEME_NAME="${GTK_ICON_THEME_NAME:-Adwaita}"

python_has_gi() {
  local py="$1"
  [[ -x "$py" ]] || return 1
  local t0 t1
  t0=$(date +%s%N 2>/dev/null || echo 0)
  "$py" -c 'import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk' >/dev/null 2>&1
  local rc=$?
  if [[ "${BUSCHAIN_CONTROL_LAT_TRACE:-}" == "1" && "$t0" != "0" ]]; then
    t1=$(date +%s%N 2>/dev/null || echo 0)
    echo "[buschain-lat] python_has_gi rc=$rc $(( (t1 - t0) / 1000000 ))ms" >&2
  fi
  return $rc
}

# 1) Explicit interpreter from nix develop / bootstrap — already validated; skip GI probe.
if [[ -n "${BUSCHAIN_CONTROL_PYTHON:-}" && -x "${BUSCHAIN_CONTROL_PYTHON}" ]]; then
  exec "$BUSCHAIN_CONTROL_PYTHON" "$PY" "$@"
fi

# 2) python3 on PATH (nix develop puts pygobject python first)
if command -v python3 >/dev/null 2>&1 && python_has_gi "$(command -v python3)"; then
  exec "$(command -v python3)" "$PY" "$@"
fi

# 3) Packaged wrap on PATH (flake/HM) — skip this script to avoid recursion
if command -v buschain-mixer-gtk >/dev/null 2>&1; then
  wrapped="$(command -v buschain-mixer-gtk)"
  wrapped_res="$(readlink -f "$wrapped" 2>/dev/null || echo "$wrapped")"
  if [[ "$wrapped_res" != "$SELF" && "$wrapped" != "$SELF" ]]; then
    exec "$wrapped" "$@"
  fi
fi

# 4) Last resort: nix run packaged mixer from this flake (needs network/cache once)
if command -v nix >/dev/null 2>&1; then
  exec nix --extra-experimental-features 'nix-command flakes' run \
    "$FLAKE_ROOT#buschain-mixer-gtk" -- "$@"
fi

echo "buschain-mixer-gtk: no pygobject Python found." >&2
echo "  Use:  nix develop   (then cargo run -- --hidden)" >&2
echo "  Or install the flake package so buschain-mixer-gtk is on PATH." >&2
exit 1

#!/usr/bin/env bash
# Waybar helper for BusChain Control.
#
# Supported contract (scroll / status ownership = buschain-ctl → tray daemon):
#   exec:            buschain-ctl status
#   on-scroll-up:    buschain-ctl hw-vol up
#   on-scroll-down:  buschain-ctl hw-vol down
#   on-click:        buschain-waybar popup   (or buschain-ctl popup playback)
#
# up|down|status here are thin aliases for older configs — same IPC path, no
# pactl dual-writer, no pending/sleep drain. Do not wrap scroll with pkill.
set -euo pipefail

resolve_ctl() {
  if [[ -n "${BUSCHAIN_CONTROL_CTL:-}" ]]; then
    CTL="$BUSCHAIN_CONTROL_CTL"
    return
  fi
  local _c
  for _c in \
    "${HOME}/Projects/buschain-control/target/debug/buschain-ctl" \
    "${HOME}/Projects/buschain-control/target/release/buschain-ctl" \
    "buschain-ctl"
  do
    if [[ "$_c" == /* && -x "$_c" ]]; then
      CTL="$_c"
      return
    elif [[ "$_c" != /* ]] && command -v "$_c" >/dev/null 2>&1; then
      CTL="$(command -v "$_c")"
      return
    fi
  done
  CTL="buschain-ctl"
}

resolve_mixer() {
  if [[ -n "${BUSCHAIN_CONTROL_MIXER:-}" ]]; then
    return
  fi
  local _m _mix_dir
  for _m in \
    "${HOME}/Projects/buschain-control/packaging/mixer/buschain-mixer-gtk" \
    "buschain-mixer-gtk" \
    "buschain-mixer"
  do
    if [[ "$_m" == /* && -x "$_m" ]]; then
      BUSCHAIN_CONTROL_MIXER="$_m"
      break
    elif [[ "$_m" != /* ]] && command -v "$_m" >/dev/null 2>&1; then
      BUSCHAIN_CONTROL_MIXER="$(command -v "$_m")"
      break
    fi
  done
  if [[ -n "${BUSCHAIN_CONTROL_MIXER:-}" && -z "${BUSCHAIN_CONTROL_MIXER_CSS:-}" ]]; then
    _mix_dir="$(dirname "$BUSCHAIN_CONTROL_MIXER")"
    if [[ -f "$_mix_dir/legacy/style.css" ]]; then
      BUSCHAIN_CONTROL_MIXER_CSS="$_mix_dir/legacy/style.css"
    elif [[ -f "$_mix_dir/style.css" ]]; then
      BUSCHAIN_CONTROL_MIXER_CSS="$_mix_dir/style.css"
    elif [[ -f "${HOME}/Projects/buschain-control/packaging/mixer/legacy/style.css" ]]; then
      BUSCHAIN_CONTROL_MIXER_CSS="${HOME}/Projects/buschain-control/packaging/mixer/legacy/style.css"
    fi
  fi
}

detach() {
  if command -v setsid >/dev/null 2>&1; then
    setsid -f "$@" >/dev/null 2>&1 || true
  else
    ( "$@" >/dev/null 2>&1 & )
  fi
}

CTL=""
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}/buschain-control"
SOCK="$RUNTIME/daemon.sock"
mkdir -p "$RUNTIME"

OFFLINE='{"text":"vol —","tooltip":"buschain-control not running (start tray app)","class":"offline"}'
NOCTL='{"text":"vol —","tooltip":"buschain-ctl missing — run ./scripts/dev (builds ctl for waybar)","class":"offline"}'

ctl_available() {
  [[ -n "$CTL" ]] || resolve_ctl
  if [[ "$CTL" == /* ]]; then
    [[ -x "$CTL" ]]
  else
    command -v "$CTL" >/dev/null 2>&1
  fi
}

# Thin alias: one writer = tray daemon via AdjustHwVolume / GetStatus.
# `exec` so latency ≈ ctl (no leftover bash after resolve).
exec_ctl() {
  if ! ctl_available; then
    if [[ -S "$SOCK" ]]; then
      echo "$NOCTL"
    else
      echo "$OFFLINE"
    fi
    exit 1
  fi
  exec "$CTL" "$@"
}

case "${1:-status}" in
  status|display)
    exec_ctl status
    ;;
  up)
    exec_ctl hw-vol up
    ;;
  down)
    exec_ctl hw-vol down
    ;;
  popup)
    resolve_ctl
    opened=0
    if ctl_available && [[ -S "$SOCK" ]]; then
      if BUSCHAIN_CONTROL_USE_GTK_MIXER="${BUSCHAIN_CONTROL_USE_GTK_MIXER:-1}" \
         "$CTL" popup playback >/dev/null 2>&1; then
        opened=1
      fi
    fi
    if ((opened == 0)); then
      resolve_mixer
      if [[ "${BUSCHAIN_CONTROL_USE_GTK_MIXER:-1}" != "0" && -n "${BUSCHAIN_CONTROL_MIXER:-}" ]]; then
        detach env \
          BUSCHAIN_CONTROL_CTL="${CTL:-}" \
          BUSCHAIN_CONTROL_MIXER_CSS="${BUSCHAIN_CONTROL_MIXER_CSS:-}" \
          "$BUSCHAIN_CONTROL_MIXER" --toggle
        opened=1
      fi
    fi
    if ((opened == 0)); then
      for bin in \
        "${HOME}/Projects/buschain-control/target/debug/buschain-control" \
        "${HOME}/Projects/buschain-control/target/release/buschain-control" \
        "buschain-control"
      do
        if [[ "$bin" == /* && -x "$bin" ]]; then
          detach env BUSCHAIN_CONTROL_SKIP_BOOTSTRAP=1 "$bin" --popup playback
          opened=1
          break
        elif [[ "$bin" != /* ]] && command -v "$bin" >/dev/null 2>&1; then
          detach env BUSCHAIN_CONTROL_SKIP_BOOTSTRAP=1 "$bin" --popup playback
          opened=1
          break
        fi
      done
    fi
    ;;
  *)
    echo "usage: $0 status|up|down|popup" >&2
    echo "prefer: buschain-ctl status | hw-vol up|down | popup playback" >&2
    exit 2
    ;;
esac

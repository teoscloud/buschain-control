#!/usr/bin/env bash
# Thin wrapper — prefer plain `cargo run` from the repo root (nix develop).
#
#   cargo run                 # tray + graph + IPC; builds plugins + buschain-ctl
#   cargo run -- --hidden     # same, withdrawn to tray
#   cargo ctl -- status       # alias → buschain-ctl
#
# This script remains for stop/shell/daemon helpers.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/target}"
export PATH="$CARGO_TARGET_DIR/debug:$PATH"

SOCK="${XDG_RUNTIME_DIR:-/tmp}/buschain-control/daemon.sock"

if [[ "${1:-}" == -* ]]; then
  cmd="run"
else
  cmd="${1:-run}"
  shift || true
fi

kill_local_daemons() {
  pkill -x buschain-daemon 2>/dev/null || true
  pkill -f '/buschain-daemon' 2>/dev/null || true
  pkill -f 'target/.*/buschain-daemon' 2>/dev/null || true
  sleep 0.2
  rm -f "$SOCK"
}

case "$cmd" in
  shell|nix)
    exec nix develop "$ROOT" -c "$SHELL"
    ;;
  rebuild|build)
    make -C "$ROOT" plugins
    exec cargo build -p buschain-control -p buschain-tools
    ;;
  run|ui|app|"")
    filtered=()
    for a in "$@"; do
      [[ "$a" == "--inprocess" ]] && continue
      filtered+=("$a")
    done
    exec cargo run -p buschain-control -- "${filtered[@]}"
    ;;
  daemon|d)
    kill_local_daemons
    exec cargo run -p buschain-tools --bin buschain-daemon
    ;;
  ctl)
    exec cargo run -p buschain-tools --bin buschain-ctl -- "$@"
    ;;
  mixer)
    # Needs gi + gtk-layer-shell — use `nix develop` (or packaged buschain-mixer-gtk).
    export BUSCHAIN_CONTROL_MIXER_CSS="${BUSCHAIN_CONTROL_MIXER_CSS:-$ROOT/packaging/mixer/legacy/style.css}"
    if [[ -z "${BUSCHAIN_CONTROL_CTL:-}" && -x "$CARGO_TARGET_DIR/debug/buschain-ctl" ]]; then
      export BUSCHAIN_CONTROL_CTL="$CARGO_TARGET_DIR/debug/buschain-ctl"
    fi
    exec python3 "$ROOT/packaging/mixer/legacy/buschain-mixer.py" "$@"
    ;;
  stop)
    kill_local_daemons
    if systemctl --user is-enabled --quiet buschain-control.service 2>/dev/null; then
      systemctl --user disable --now buschain-control.service || true
    fi
    # Also quit a leftover tray/debug binary if requested via STOP_UI=1
    if [[ "${STOP_UI:-}" == "1" ]]; then
      pkill -x buschain-control 2>/dev/null || true
    fi
    echo "Stopped leftover headless daemons / old user unit."
    ;;
  help|-h|--help)
    cat <<'EOF'
BusChain Control — local workflow

  Preferred:
    nix develop
    cargo run              # plugins + buschain-ctl + tray app
    cargo run -- --hidden
    cargo ctl -- status

  Helpers (this script):
    ./scripts/dev stop
    ./scripts/dev shell
    ./scripts/dev daemon   # legacy headless only
EOF
    ;;
  *)
    echo "unknown: $cmd (try ./scripts/dev help)" >&2
    exit 2
    ;;
esac

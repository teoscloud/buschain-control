@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<https://github.com/local/buschain_gate#gate>
  a lv2:Plugin , lv2:DynamicsPlugin ;
  doap:name "BusChain Gate" ;
  doap:license <http://opensource.org/licenses/MIT> ;
  lv2:project <https://github.com/local/buschain_gate> ;
  lv2:optionalFeature lv2:hardRTCapable ;

  rdfs:comment """
Stereo noise gate with hysteresis, hold, and range.
Split from BusChain Denoiser for independent use in any LADSPA/LV2 host.
""" ;

  lv2:port [
    a lv2:AudioPort , lv2:InputPort ;
    lv2:index 0 ;
    lv2:symbol "in_l" ;
    lv2:name "Input L"
  ] , [
    a lv2:AudioPort , lv2:InputPort ;
    lv2:index 1 ;
    lv2:symbol "in_r" ;
    lv2:name "Input R"
  ] , [
    a lv2:AudioPort , lv2:OutputPort ;
    lv2:index 2 ;
    lv2:symbol "out_l" ;
    lv2:name "Output L"
  ] , [
    a lv2:AudioPort , lv2:OutputPort ;
    lv2:index 3 ;
    lv2:symbol "out_r" ;
    lv2:name "Output R"
  ] , [
    a lv2:ControlPort , lv2:InputPort ;
    lv2:index 4 ;
    lv2:symbol "enable" ;
    lv2:name "Enable" ;
    lv2:default 1.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1.0 ;
    lv2:portProperty lv2:toggled
  ] , [
    a lv2:ControlPort , lv2:InputPort ;
    lv2:index 5 ;
    lv2:symbol "threshold" ;
    lv2:name "Threshold" ;
    lv2:default -78.0 ;
    lv2:minimum -140.0 ;
    lv2:maximum 0.0 ;
    units:unit units:db
  ] , [
    a lv2:ControlPort , lv2:InputPort ;
    lv2:index 6 ;
    lv2:symbol "hysteresis" ;
    lv2:name "Hysteresis" ;
    lv2:default 3.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 24.0 ;
    units:unit units:db
  ] , [
    a lv2:ControlPort , lv2:InputPort ;
    lv2:index 7 ;
    lv2:symbol "attack" ;
    lv2:name "Attack" ;
    lv2:default 2.0 ;
    lv2:minimum 0.1 ;
    lv2:maximum 50.0 ;
    units:unit units:ms
  ] , [
    a lv2:ControlPort , lv2:InputPort ;
    lv2:index 8 ;
    lv2:symbol "hold" ;
    lv2:name "Hold" ;
    lv2:default 80.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 500.0 ;
    units:unit units:ms
  ] , [
    a lv2:ControlPort , lv2:InputPort ;
    lv2:index 9 ;
    lv2:symbol "release" ;
    lv2:name "Release" ;
    lv2:default 120.0 ;
    lv2:minimum 1.0 ;
    lv2:maximum 1000.0 ;
    units:unit units:ms
  ] , [
    a lv2:ControlPort , lv2:InputPort ;
    lv2:index 10 ;
    lv2:symbol "range" ;
    lv2:name "Range" ;
    lv2:default 100.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 140.0 ;
    units:unit units:db
  ] , [
    a lv2:ControlPort , lv2:InputPort ;
    lv2:index 11 ;
    lv2:symbol "bypass" ;
    lv2:name "Bypass" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1.0 ;
    lv2:portProperty lv2:toggled
  ] , [
    a lv2:ControlPort , lv2:OutputPort ;
    lv2:index 12 ;
    lv2:symbol "meter_gain" ;
    lv2:name "Gate Gain" ;
    lv2:minimum 0.0 ;
    lv2:maximum 1.0
  ] .
